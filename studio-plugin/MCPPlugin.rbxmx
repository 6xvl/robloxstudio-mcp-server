		sampled_frame_min = sampledFrameMin,
		sampled_frame_max = sampledFrameMax,
	}
	local _left_5 = "sampled_frames"
	-- ▼ ReadonlySet.size ▼
	local _size_2 = 0
	for _ in sampledFrames do
		_size_2 += 1
	end
	-- ▲ ReadonlySet.size ▲
	_object_3[_left_5] = _size_2
	_object_3.events_sampled = eventsSampled
	_object_3.enter_events = enterEvents
	_object_3.exit_events = exitEvents
	_object_3.unmatched_exits = unmatchedExits
	_object_3.dropped_spans = droppedSpans
	_object_3.open_stack_entries_at_end = openStackEntriesAtEnd
	_object_3.iterator_finished = iteratorFinished
	_object_3.last_processed_frame_id = lastProcessedFrameId
	_object_3.last_processed_timestamp_us = if lastProcessedTimestampRaw ~= nil then rawToUs(lastProcessedTimestampRaw) else nil
	_object_3.event_limit_hit = eventsSampled >= maxEvents
	_object[_left_4] = _object_3
	_object.frame_summary = frameSummary
	_object.top_groups = topGroups
	_object.top_groups_by_exclusive = topGroupsByExclusive
	_object.top_threads = topThreads
	_object.top_call_edges = topEdges
	_object.top_timers = topTimers
	_object.top_timers_by_exclusive = topTimersByExclusive
	_object.data_quality = {
		event_limit_hit = eventsSampled >= maxEvents,
		iterator_finished = iteratorFinished,
		unmatched_exits = unmatchedExits,
		dropped_spans = droppedSpans,
		open_stack_entries_at_end = openStackEntriesAtEnd,
		selected_frame_event_coverage_pct = sampledFrameCoveragePct,
		partial = #partialReasons > 0,
		partial_reasons = partialReasons,
		notes = if focus ~= "all" then { "focus filters events before stack aggregation; exclusive_us is exclusive within emitted focused events, not the full snapshot." } else nil,
	}
	_object.recommended_tools = recommendedToolsForGroups(topGroups, targetRole)
	local result = _object
	if (next(omitted)) ~= nil then
		result.omitted = omitted
