	urlInput.ClearTextOnFocus = false
	urlInput.PlaceholderText = "Server URL..."
	urlInput.PlaceholderColor3 = C.muted
	urlInput.LayoutOrder = 1
	urlInput.Parent = card
	local urlCorner = Instance.new("UICorner")
