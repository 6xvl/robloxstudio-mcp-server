\t\t\t-- a payload-chunk line number (the traceback header / engine\
\t\t\t-- C frames) are kept; remap is a no-op for them.\
\t\t\tif n and (n <= __mcp_LINE_OFFSET or n > __mcp_LINE_OFFSET + __mcp_USER_LINES) then\
\t\t\t\tskip = true\
\t\t\tend\
