		end
		if instance:IsA("SpecialMesh") then
			properties.MeshId = tostring(instance.MeshId)
			properties.TextureId = tostring(instance.TextureId)
			properties.MeshType = tostring(instance.MeshType)
		end
		if instance:IsA("Sound") then
